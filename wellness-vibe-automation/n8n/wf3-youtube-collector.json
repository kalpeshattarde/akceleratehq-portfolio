                  {
                      "parameters":  {
                                         "jsCode":  "\nconst input = $(\u0027Input\u0027).first().json;\nconst statsResp = $(\u0027Channel Stats\u0027).first().json || {};\nconst anResp = $(\u0027Daily Analytics\u0027).first().json || {};\n\nfunction statusOf(resp) {\n  return resp \u0026\u0026 resp.statusCode != null ? Number(resp.statusCode) : null;\n}\nfunction isOk(s) { return s != null \u0026\u0026 s \u003e= 200 \u0026\u0026 s \u003c 300; }\n\nfunction subCount() {\n  try {\n    const items = statsResp.body \u0026\u0026 Array.isArray(statsResp.body.items) ? statsResp.body.items : [];\n    if (!items.length) return null;\n    const st = items[0].statistics || {};\n    const v = st.subscriberCount;\n    return v == null ? null : Number(v);\n  } catch (e) { return null; }\n}\nfunction analyticVal(name) {\n  try {\n    const body = anResp.body || {};\n    const headers = Array.isArray(body.columnHeaders) ? body.columnHeaders : [];\n    const rows = Array.isArray(body.rows) ? body.rows : [];\n    if (!headers.length || !rows.length) return null;\n    const idx = headers.findIndex(function (h) { return h.name === name; });\n    if (idx \u003c 0) return null;\n    const v = rows[0][idx];\n    return v == null ? null : Number(v);\n  } catch (e) { return null; }\n}\n\nconst sStatus = statusOf(statsResp);\nconst aStatus = statusOf(anResp);\nconst sOk = isOk(sStatus);\nconst aOk = isOk(aStatus);\n\nlet data_status = \u0027FAILED\u0027;\nif (sOk \u0026\u0026 aOk) data_status = \u0027SUCCESS\u0027;\nelse if (sOk || aOk) data_status = \u0027PARTIAL\u0027;\n\nconst errors = [];\nif (!sOk) errors.push(\u0027Channel stats HTTP \u0027 + (sStatus == null ? \u0027no-response\u0027 : sStatus));\nif (!aOk) errors.push(\u0027Analytics HTTP \u0027 + (aStatus == null ? \u0027no-response\u0027 : aStatus));\n\nconst out = {\n  run_id: input.run_id || null,\n  target_date: input.target_date || null,\n  account_id: input.account_id || null,\n  brand_id: input.brand_id || null,\n  brand_name: input.brand_name || null,\n  platform: \u0027YouTube\u0027,\n  account_type: input.account_type || null,\n  platform_account_id: input.platform_account_id || null,\n  followers: subCount(),\n  followers_gained: analyticVal(\u0027subscribersGained\u0027),\n  followers_lost: analyticVal(\u0027subscribersLost\u0027),\n  impressions: null,\n  reach: null,\n  views: analyticVal(\u0027views\u0027),\n  likes: analyticVal(\u0027likes\u0027),\n  comments: analyticVal(\u0027comments\u0027),\n  shares: analyticVal(\u0027shares\u0027),\n  saves: null,\n  engagements: null,\n  engagement_rate: null,\n  posts_published: null,\n  video_views: analyticVal(\u0027views\u0027),\n  watch_time: analyticVal(\u0027estimatedMinutesWatched\u0027),\n  profile_views: null,\n  link_clicks: null,\n  data_status: data_status,\n  collected_at: new Date().toISOString(),\n  error_message: errors.length ? errors.join(\u0027; \u0027) : null,\n  http_status: (sOk \u0026\u0026 aOk) ? 200 : (!sOk ? (sStatus == null ? null : sStatus) : (aStatus == null ? null : aStatus)),\n  operation: \u0027youtube.channel_daily_analytics\u0027,\n};\nreturn [{ json: out }];\n"
                                     },
