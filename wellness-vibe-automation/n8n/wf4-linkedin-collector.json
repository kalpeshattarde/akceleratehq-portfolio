                  {
                      "parameters":  {
                                         "jsCode":  "\nconst input = $(\u0027Input\u0027).first().json;\nconst fResp = $(\u0027Follower Stats\u0027).first().json || {};\nconst sResp = $(\u0027Share Stats\u0027).first().json || {};\n\nfunction statusOf(resp) {\n  return resp \u0026\u0026 resp.statusCode != null ? Number(resp.statusCode) : null;\n}\nfunction isOk(s) { return s != null \u0026\u0026 s \u003e= 200 \u0026\u0026 s \u003c 300; }\nfunction firstEl(resp) {\n  try {\n    const body = resp \u0026\u0026 resp.body ? resp.body : {};\n    const arr = Array.isArray(body.elements) ? body.elements : [];\n    return arr.length ? arr[0] : null;\n  } catch (e) { return null; }\n}\nfunction num(v) { return v == null ? null : Number(v); }\n\nconst fStatus = statusOf(fResp);\nconst sStatus = statusOf(sResp);\nconst fOk = isOk(fStatus);\nconst sOk = isOk(sStatus);\n\nlet followers = null;\ntry {\n  const el = firstEl(fResp);\n  if (el \u0026\u0026 el.followerCounts) {\n    const org = num(el.followerCounts.organicFollowerCount) || 0;\n    const paid = num(el.followerCounts.paidFollowerCount) || 0;\n    followers = org + paid;\n  }\n} catch (e) { followers = null; }\n\nlet stats = {};\ntry {\n  const el = firstEl(sResp);\n  stats = (el \u0026\u0026 el.totalShareStatistics) ? el.totalShareStatistics : {};\n} catch (e) { stats = {}; }\n\nlet data_status = \u0027FAILED\u0027;\nif (fOk \u0026\u0026 sOk) data_status = \u0027SUCCESS\u0027;\nelse if (fOk || sOk) data_status = \u0027PARTIAL\u0027;\n\nconst errors = [];\nif (!fOk) errors.push(\u0027Follower stats HTTP \u0027 + (fStatus == null ? \u0027no-response\u0027 : fStatus));\nif (!sOk) errors.push(\u0027Share stats HTTP \u0027 + (sStatus == null ? \u0027no-response\u0027 : sStatus));\n\nconst out = {\n  run_id: input.run_id || null,\n  target_date: input.target_date || null,\n  account_id: input.account_id || null,\n  brand_id: input.brand_id || null,\n  brand_name: input.brand_name || null,\n  platform: \u0027LinkedIn\u0027,\n  account_type: input.account_type || null,\n  platform_account_id: input.platform_account_id || null,\n  followers: followers,\n  followers_gained: null,\n  followers_lost: null,\n  impressions: num(stats.impressionCount),\n  reach: num(stats.uniqueImpressionsCount),\n  views: null,\n  likes: num(stats.likeCount),\n  comments: num(stats.commentCount),\n  shares: num(stats.shareCount),\n  saves: null,\n  engagements: (function () {\n    const l = num(stats.likeCount) || 0;\n    const c = num(stats.commentCount) || 0;\n    const s = num(stats.shareCount) || 0;\n    const ck = num(stats.clickCount) || 0;\n    const any = stats.likeCount != null || stats.commentCount != null || stats.shareCount != null || stats.clickCount != null;\n    return any ? (l + c + s + ck) : null;\n  })(),\n  engagement_rate: (stats.engagement != null ? Number(stats.engagement) : null),\n  posts_published: null,\n  video_views: null,\n  watch_time: null,\n  profile_views: null,\n  link_clicks: num(stats.clickCount),\n  data_status: data_status,\n  collected_at: new Date().toISOString(),\n  error_message: errors.length ? errors.join(\u0027; \u0027) : null,\n  http_status: (fOk \u0026\u0026 sOk) ? 200 : (!fOk ? (fStatus == null ? null : fStatus) : (sStatus == null ? null : sStatus)),\n  operation: \u0027linkedin.org_daily_statistics\u0027,\n};\nreturn [{ json: out }];\n"
