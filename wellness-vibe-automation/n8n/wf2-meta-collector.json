orm: \u0027Instagram\u0027,\n  account_type: input.account_type || null,\n  platform_account_id: input.platform_account_id || null,\n  followers: bodyField(profile, \u0027followers_count\u0027),\n  followers_gained: null,\n  followers_lost: null,\n  impressions: metricVal(insights, \u0027impressions\u0027),\n  reach: metricVal(insights, \u0027reach\u0027),\n  views: null,\n  likes: null,\n  comments: null,\n  shares: null,\n  saves: null,\n  engagements: null,\n  engagement_rate: null,\n  posts_published: null,\n  video_views: null,\n  watch_time: null,\n  profile_views: metricVal(insights, \u0027profile_views\u0027),\n  link_clicks: null,\n  data_status: data_status,\n  collected_at: new Date().toISOString(),\n  error_message: errors.length ? errors.join(\u0027; \u0027) : null,\n  http_status: okCount === total ? 200 : (statuses.find(function (s) { return s == null || s \u003c 200 || s \u003e= 300; }) || null),\n  operation: \u0027meta.instagram.daily_insights\u0027,\n};\nreturn [{ json: out }];\n"
