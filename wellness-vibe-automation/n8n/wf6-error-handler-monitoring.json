                  {
                      "parameters":  {
                                         "jsCode":  "\nconst input = $(\u0027Input\u0027).first().json;\nlet results = [];\nlet recordsWritten = null;\nlet apiRequests = null;\ntry {\n  const parsed = JSON.parse(input.payload || \u0027{}\u0027);\n  results = Array.isArray(parsed.results) ? parsed.results : (Array.isArray(parsed) ? parsed : []);\n  if (parsed \u0026\u0026 parsed.records_written != null) recordsWritten = Number(parsed.records_written);\n  if (parsed \u0026\u0026 parsed.api_requests != null) apiRequests = Number(parsed.api_requests);\n} catch (e) {\n  results = [];\n}\n\nfunction statusOf(r) { return String(r.data_status || r.status || \u0027\u0027).toUpperCase(); }\n\nconst total = results.length;\nconst successful = results.filter(function (r) { return statusOf(r) === \u0027SUCCESS\u0027; }).length;\nconst partial = results.filter(function (r) { return statusOf(r) === \u0027PARTIAL\u0027; }).length;\nconst failed = results.filter(function (r) { return statusOf(r) === \u0027FAILED\u0027; }).length;\n\nconst problems = results.filter(function (r) {\n  const s = statusOf(r);\n  return s === \u0027FAILED\u0027 || s === \u0027PARTIAL\u0027;\n});\n\nlet lines = \u0027\u0027;\nfor (let i = 0; i \u003c problems.length; i++) {\n  const p = problems[i];\n  lines += \u0027- Brand: \u0027 + (p.brand_name || p.brand_id || \u0027n/a\u0027) +\n    \u0027 | Account: \u0027 + (p.account_id || \u0027n/a\u0027) +\n    \u0027 | Platform: \u0027 + (p.platform || \u0027n/a\u0027) +\n    \u0027 | Status: \u0027 + statusOf(p) +\n    \u0027 | HTTP: \u0027 + (p.http_status == null ? \u0027n/a\u0027 : p.http_status) +\n    \u0027 | Error: \u0027 + (p.error_message || \u0027n/a\u0027) +\n    \u0027 | Time: \u0027 + (p.collected_at || new Date().toISOString()) +\n    \u0027\\n\u0027;\n}\n\nconst hasProblems = problems.length \u003e 0;\n\nconst summaryText =\n  \u0027Run ID: \u0027 + (input.run_id || \u0027n/a\u0027) + \u0027\\n\u0027 +\n  \u0027Target date: \u0027 + (input.target_date || \u0027n/a\u0027) + \u0027\\n\u0027 +\n  \u0027Total accounts: \u0027 + total + \u0027\\n\u0027 +\n  \u0027Successful: \u0027 + successful + \u0027\\n\u0027 +\n  \u0027Partial: \u0027 + partial + \u0027\\n\u0027 +\n  \u0027Failed: \u0027 + failed + \u0027\\n\u0027 +\n  \u0027Total API requests: \u0027 + (apiRequests == null ? \u0027n/a\u0027 : apiRequests) + \u0027\\n\u0027 +\n  \u0027Total records written: \u0027 + (recordsWritten == null ? \u0027n/a\u0027 : recordsWritten) + \u0027\\n\\n\u0027 +\n  (hasProblems ? (\u0027Accounts needing attention:\\n\u0027 + lines) : \u0027All accounts succeeded.\u0027);\n\nreturn [{\n  json: {\n    run_id: input.run_id || null,\n    target_date: input.target_date || null,\n    total_accounts: total,\n    successful: successful,\n    partial: partial,\n    failed: failed,\n    total_api_requests: apiRequests,\n    total_records_written: recordsWritten,\n    has_problems: hasProblems,\n    problem_count: problems.length,\n    summary_text: summaryText,\n  },\n}];\n"
                                     },
