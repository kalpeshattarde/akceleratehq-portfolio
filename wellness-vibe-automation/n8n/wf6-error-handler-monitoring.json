                  {
                      "parameters":  {
                                         "jsCode":  "\nconst input = $(\u0027Input\u0027).first().json;\nlet rows = [];\ntry {\n  const parsed = JSON.parse(input.payload || \u0027[]\u0027);\n  rows = Array.isArray(parsed) ? parsed : (parsed \u0026\u0026 Array.isArray(parsed.rows) ? parsed.rows : []);\n} catch (e) {\n  rows = [];\n}\nif (!rows.length) return [];\nreturn rows.map(function (r) {\n  return {\n    json: {\n      Run_ID: input.run_id || r.run_id || null,\n      Timestamp: r.timestamp || new Date().toISOString(),\n      Workflow: r.workflow || null,\n      Account_ID: r.account_id || null,\n      Platform: r.platform || null,\n      Operation: r.operation || null,\n      Status: r.status || r.data_status || null,\n      HTTP_Status: r.http_status == null ? \u0027\u0027 : r.http_status,\n      Execution_ID: r.execution_id || null,\n      Retry_Count: r.retry_count == null ? \u0027\u0027 : r.retry_count,\n      Error_Message: r.error_message || \u0027\u0027,\n      Duration_ms: r.duration_ms == null ? \u0027\u0027 : r.duration_ms,\n    },\n  };\n});\n"
